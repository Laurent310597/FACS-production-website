# Copy this file to .env.local for local development.
# In Vercel, add the same variables in Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Edge Function secrets are configured in Supabase Dashboard, NOT in this Vite file:
# LARK_APP_ID, LARK_APP_SECRET, FACS_CRON_SECRET, FACS_SITE_URL=https://facs.vn
