# Copy this file to .env.local for local development.
# In Vercel, add the same variables in Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Server-only values belong in Supabase Edge Function Secrets, never in this file:
# LARK_APP_ID, LARK_APP_SECRET, FACS_SITE_URL, FACS_CRON_SECRET
# GROQ_API_KEY
# Optional Groq model overrides:
#   GROQ_LEGAL_CALENDAR_MODEL=openai/gpt-oss-120b
#   GROQ_PUBLIC_LEGAL_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY is used only by the private authenticated CMS assistant.
# Optional OpenAI model override:
#   OPENAI_CMS_ASSISTANT_MODEL=gpt-5.6-sol
# Optional, separately scoped Legal Calendar fallback (disabled by default):
#   OPENAI_LEGAL_CALENDAR_API_KEY=YOUR_SEPARATE_SERVER_KEY
#   OPENAI_LEGAL_CALENDAR_MODEL=gpt-5.6
# Optional comma-separated origin allowlist shared by the AI Edge Functions:
#   FACS_AI_ALLOWED_ORIGINS=https://facs.vn,https://www.facs.vn
