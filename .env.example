# Copy this file to .env.local for local development.
# In Vercel, add the same variables in Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Server-only values belong in Supabase Edge Function Secrets, never in this file:
# LARK_APP_ID, LARK_APP_SECRET, FACS_SITE_URL, FACS_CRON_SECRET
# GROQ_API_KEY and optionally GROQ_LEGAL_CALENDAR_MODEL (default: openai/gpt-oss-120b)
# OPENAI_API_KEY remains supported as a fallback when GROQ_API_KEY is absent.
